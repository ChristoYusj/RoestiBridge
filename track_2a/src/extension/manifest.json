{
  "manifest_version": 2,
  "name": "RöstiBridge",
  "version": "0.1.0",
  "description": "Flags meaning differences between language versions of Swiss government pages, RTS articles and parliamentary PDFs, using Apertus.",
  "browser_specific_settings": {
    "gecko": { "id": "roestibridge@hackapertus.local", "strict_min_version": "115.0" }
  },
  "icons": { "48": "icons/icon.svg", "96": "icons/icon.svg" },
  "permissions": [
    "storage",
    "webRequest",
    "webRequestBlocking",
    "*://*.ch/*",
    "*://*.swiss/*",
    "https://api.inference.cscs.ch/*",
    "https://www.bing.com/*",
    "https://html.duckduckgo.com/*",
    "https://api.openparldata.ch/*"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": { "scripts": ["shared/engine.js", "shared/sites.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["*://*.ch/*", "*://*.swiss/*"],
      "exclude_matches": ["*://*.rts.ch/*", "*://*.srf.ch/*"],
      "js": ["shared/sites.js", "content/highlight.js", "content/extract.js", "content/gov.js"],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://*.rts.ch/*"],
      "js": ["shared/sites.js", "content/highlight.js", "content/extract.js", "content/rts.js"],
      "css": ["content/style.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options/options.html", "open_in_tab": true },
  "browser_action": { "default_title": "RöstiBridge", "default_icon": "icons/icon.svg", "default_popup": "options/options.html" },
  "web_accessible_resources": ["shared/prompt.json", "pdf/*", "content/style.css"]
}
